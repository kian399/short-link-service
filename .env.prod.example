# 生产环境变量模板：复制成 .env 再改值
# cp .env.prod.example .env && vim .env
#
# 注意：.env 已被 .gitignore 忽略，不要提交带真实密钥的文件

ENV=prod

# 创建/删除接口的鉴权 Key，必须换成随机串：openssl rand -hex 32
API_KEY=change-me-to-a-random-string

# 短链拼接用的公网地址（nginx 对外暴露的域名或 IP）
BASE_URL=https://your-domain.com

# 本地开发时用 localhost；容器内由 docker-compose.prod.yml 覆盖成服务名
DATABASE_URL=postgresql+psycopg2://shortlink:shortlink_pwd@localhost:5432/shortlink
REDIS_URL=redis://localhost:6379/0

# PostgreSQL 容器初始化参数（compose 里引用）
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=shortlink

# 缓存
CACHE_TTL=3600
CACHE_L1_ENABLED=true
CACHE_L2_ENABLED=true
SINGLEFLIGHT_ENABLED=true
L1_CACHE_SIZE=10000
L1_CACHE_TTL=30

# 限流（每分钟）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIRECT_PER_MIN=600
RATE_LIMIT_CREATE_PER_MIN=60

# 埋点
STATS_RECORD_ENABLED=true
STATS_FLUSH_ENABLED=true
STATS_FLUSH_INTERVAL=60

# 数据库连接池（按 worker 数均分，见 app/db.py）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

LOG_LEVEL=INFO
